<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/selective_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#26CCFF"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="Chỉnh sửa cục bộ"
        app:navigationIcon="@drawable/ic_close_24"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.mpcorporation.snapeffect.presentation.selective.widget.BrushMaskView
        android:id="@+id/brush_mask_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/selective_toolbar"
        app:layout_constraintBottom_toTopOf="@id/selective_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/selective_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Brush size -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/label_brush_size" android:layout_width="80dp"
                android:layout_height="wrap_content" android:text="Cọ: 80px"
                android:textColor="#CCCCCC" android:textSize="12sp"/>
            <SeekBar android:id="@+id/seekbar_brush_size" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:max="100" android:progress="40"/>
        </LinearLayout>

        <!-- Brightness -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                android:text="Sáng" android:textColor="#CCCCCC" android:textSize="12sp"/>
            <SeekBar android:id="@+id/seekbar_sel_brightness" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:max="100" android:progress="50"/>
        </LinearLayout>

        <!-- Contrast -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                android:text="Tương phản" android:textColor="#CCCCCC" android:textSize="12sp"/>
            <SeekBar android:id="@+id/seekbar_sel_contrast" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:max="100" android:progress="33"/>
        </LinearLayout>

        <!-- Saturation -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                android:text="Bão hòa" android:textColor="#CCCCCC" android:textSize="12sp"/>
            <SeekBar android:id="@+id/seekbar_sel_saturation" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:max="100" android:progress="50"/>
        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="8dp">
            <Button android:id="@+id/btn_eraser" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Tẩy" android:alpha="0.5" android:layout_marginEnd="4dp"
                style="@style/Widget.AppCompat.Button.Colored"/>
            <Button android:id="@+id/btn_clear_mask" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Xóa mask" android:layout_marginEnd="4dp"
                style="@style/Widget.AppCompat.Button.Colored"/>
            <Button android:id="@+id/btn_selective_confirm" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1.5"
                android:text="Áp dụng"
                style="@style/Widget.AppCompat.Button.Colored"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
