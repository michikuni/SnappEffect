<?xml version="1.0" encoding="utf-8"?>
<!-- Native Horizontal - media bên trái, (icon + headline + body) bên phải, CTA bottom (~210dp) -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ad_template_horizontal_card_padding">
        <aapt:attr name="android:background">
            <shape android:shape="rectangle">
                <solid android:color="@color/ad_template_horizontal_card_bg_color" />
                <stroke android:width="@dimen/ad_template_horizontal_card_stroke_width" android:color="@color/ad_template_horizontal_card_stroke_color" />
                <corners android:radius="@dimen/ad_template_horizontal_card_radius" />
            </shape>
        </aapt:attr>

        <!-- Hàng trên: media (trái) + nội dung (phải) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ad_template_horizontal_group2_height"
            android:orientation="horizontal">

            <!-- Media bên trái -->
            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="@dimen/ad_template_horizontal_media_width"
                android:layout_height="match_parent" />

            <!-- Cột phải: header (icon + headline) + body -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/ad_template_horizontal_group3_margin_start"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Header: icon + (badge + headline) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ad_app_icon"
                        android:layout_width="@dimen/ad_template_horizontal_icon_width"
                        android:layout_height="@dimen/ad_template_horizontal_icon_height"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ad_template_horizontal_group5_margin_start"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/ad_template_horizontal_label_padding_start"
                            android:paddingTop="@dimen/ad_template_horizontal_label_padding_top"
                            android:paddingEnd="@dimen/ad_template_horizontal_label_padding_end"
                            android:paddingBottom="@dimen/ad_template_horizontal_label_padding_bottom"
                            android:text="@string/ad_attribution"
                            android:textColor="@color/ad_template_horizontal_label_text_color"
                            android:textSize="@dimen/ad_template_horizontal_label_text_size"
                            android:textStyle="bold">
                            <aapt:attr name="android:background">
                                <shape android:shape="rectangle">
                                    <solid android:color="@color/ad_template_horizontal_label_bg_color" />
                                    <corners android:radius="@dimen/ad_template_horizontal_label_radius" />
                                </shape>
                            </aapt:attr>
                        </TextView>

                        <TextView
                            android:id="@+id/ad_headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ad_template_horizontal_title_margin_top"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/ad_template_horizontal_title_text_color"
                            android:textSize="@dimen/ad_template_horizontal_title_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Body chiếm phần cao còn lại của cột phải -->
                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/ad_template_horizontal_desc_margin_top"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="top"
                    android:maxLines="4"
                    android:textColor="@color/ad_template_horizontal_desc_text_color"
                    android:textSize="@dimen/ad_template_horizontal_desc_text_size" />
            </LinearLayout>
        </LinearLayout>

        <!-- CTA bottom full-width -->
        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ad_template_horizontal_cta_height"
            android:layout_marginTop="@dimen/ad_template_horizontal_cta_margin_top"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/ad_template_horizontal_cta_text_color"
            android:textSize="@dimen/ad_template_horizontal_cta_text_size"
            android:textStyle="bold">
            <aapt:attr name="android:background">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ad_template_horizontal_cta_bg_color" />
                    <corners android:radius="@dimen/ad_template_horizontal_cta_radius" />
                </shape>
            </aapt:attr>
        </Button>
    </LinearLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
