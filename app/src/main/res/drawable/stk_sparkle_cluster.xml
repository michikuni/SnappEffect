      android:pivotX="60"
      android:pivotY="60"
      android:scaleX="0.62"
      android:scaleY="0.62"
      android:translateX="-14"
      android:translateY="-14">
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#8B5CF6"
