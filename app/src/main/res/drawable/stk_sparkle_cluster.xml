        android:pathData="M60,10 C64,42 78,56 110,60 C78,64 64,78 60,110 C56,78 42,64 10,60 C42,56 56,42 60,10 Z"/>
  </group>
  <group
      android:pivotX="60"
      android:pivotY="60"
      android:scaleX="0.34"
      android:scaleY="0.34"
      android:translateX="30"
      android:translateY="12">
