        android:fillColor="#FF7AB0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineJoin="round"
        android:pathData="M60,10 C64,42 78,56 110,60 C78,64 64,78 60,110 C56,78 42,64 10,60 C42,56 56,42 60,10 Z"/>
  </group>
  <group
      android:pivotX="60"
      android:pivotY="60"
      android:scaleX="0.24"
      android:scaleY="0.24"
      android:translateX="-26"
      android:translateY="36">
    <path
        android:fillColor="#F5A623"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineJoin="round"
        android:pathData="M60,10 C64,42 78,56 110,60 C78,64 64,78 60,110 C56,78 42,64 10,60 C42,56 56,42 60,10 Z"/>
  </group>
</vector>
